// --- FASTFETCH CONFIG ---

// ensure Jetbrains Mono NerdFont is installed to display ligatures properly 

// backup your /home/username/.config/fastfetch/config.jsonc
// rename this config to config.jsonc and copy to /home/username/.config/fastfetch/

// image used was 800 x 800 px, you can choose any image/size you want
// replace "/path/to-file/filename.png" with your path and filename
// ensure its in /home/username/.config/fastfetch/

// to preserve privacy when posting screenshots online username and IP address
// module information has been removed

// official documentation https://github.com/fastfetch-cli/fastfetch/wiki

{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/path/to-file/filename.png",
        "width": 28,
        "height": 14,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
    "break",    
        {
            "key": "{#37}╭─────────────╮",
            "type": "custom"
        },
        {
            "key": "{#37}│ {#31}󰇅 Host      {#keys}{#37}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "{#37}│ {#31}{icon} Distro    {#keys}{#37}│",
            "type": "os"
        },
        {
            "key": "{#37}│ {#31} Kernel    {#keys}{#37}│",
            "type": "kernel"
        },
        {
            "key": "{#37}│ {#31} Install   {#keys}{#37}│",
            "type": "command",
            "text": "LC_ALL=C date -d \"@$(stat -c %W /)\" \"+%d-%m-%Y %H:%M\" 2>/dev/null || echo N/A"

        },
        {
            "key": "{#37}│ {#32}󰇄 DE        {#keys}{#37}│",
            "type": "de"
        },
        {
            "key": "{#37}│ {#32} Terminal  {#keys}{#37}│",
            "type": "terminal"
        },
        {
            "key": "{#37}│ {#32} Shell     {#keys}{#37}│",
            "type": "shell"
        },
        {
            "key": "{#37}│ {#32} Font      {#keys}{#37}│",
            "type": "terminalfont"
        },
        {
            "key": "{#37}│ {#36}󰍛 CPU       {#keys}{#37}│",
            "type": "cpu",
            "format": "{name} {freq-max}"
        },
        {
            "key": "{#37}│ {#36}󰉉 Disk      {#keys}{#37}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#37}│ {#36} Memory    {#keys}{#37}│",
            "type": "memory"
        },
        {
            "key": "{#37}│ {#36}󰓡 Swap      {#keys}{#37}│",       
            "type": "swap"
        },
        {
            "key": "{#37}├─────────────┤",
            "type": "custom"
        },
        {
            "key": "{#37}│ {#39} Colours   {#keys}{#37}│",
            "type": "Colors",
            "symbol": "circle"
        },
        {
            "key": "{#37}╰─────────────╯",
            "type": "custom"
        }
    ]
}
