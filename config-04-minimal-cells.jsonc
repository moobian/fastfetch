// --- FASTFETCH CONFIG ---

// ensure Jetbrains Mono NerdFont is installed to display ligatures properly 

// backup your /home/username/.config/fastfetch/config.jsonc
// rename this config to config.jsonc and copy to /home/username/.config/fastfetch/

// image used was 800 x 800 px, you can choose any image/size you want
// replace "/path/to-file/filename.png" with your path and filename
// ensure its in /home/username/.config/fastfetch/

// to preserve privacy when posting screenshots online username and IP address
// module information has been removed

// official documentation https://github.com/fastfetch-cli/fastfetch/wiki

{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/path/to-file/filename.png",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 1,
            "left": 10,
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        //"break",
        //"break",
        {
            "key": "{#38;5;244}╭─────────────╮",
            "type": "custom"
        },
        {
            "key": "{#38;5;244}│ {#31}{icon} Distro    {#keys}{#38;5;244}│",
            "type": "os"
        },
        {
            "key": "{#38;5;244}├─────────────┤",
            "type": "custom"
        },            
        {
            "key": "{#38;5;244}│ {#32} Kernel    {#keys}{#38;5;244}│",
            "type": "kernel"
        },
        {
            "key": "{#38;5;244}│ {#32}󰇄 DE        {#keys}{#38;5;244}│",
            "type": "de"
        },
        {
            "key": "{#38;5;244}│ {#32} Terminal  {#keys}{#38;5;244}│",
            "type": "terminal"
        },
        {
            "key": "{#38;5;244}│ {#32}󰍛 CPU       {#keys}{#38;5;244}│",
            "type": "cpu",
            "format": "{name} {freq-max}"
        },
        {
            "key": "{#38;5;244}│ {#32} Memory    {#keys}{#38;5;244}│",
            "type": "memory"
        },
        {
            "key": "{#38;5;244}├─────────────┤",
            "type": "custom"
        },
        {
            "key": "{#38;5;244}│ {#36} Colours   {#keys}{#38;5;244}│",
            "type": "Colors",
            "symbol": "circle"
        },        
        {
            "key": "{#38;5;244}╰─────────────╯",
            "type": "custom"
        }
    ]
}
