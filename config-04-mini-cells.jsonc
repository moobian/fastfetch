// --- FASTFETCH CONFIG ---

// place config in /home/username/.config/fastfetch/, ensure the file name is config.jsonc
// ensure Jetbrains Mono NerdFont is installed to display ligatures properly 
// official fastfetch examples located at /usr/share/fastfetch/presets/examples
// image used was 800 x 800 px, ensure its in the same directory as your fastfetch config 

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/debian-square-tr.png",
        //"source": "/path/to-file/filename.png",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 1,
            "left": 10,
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        //"break",
        //"break",
        {
            "key": "{#38;5;244}╭─────────────╮",
            "type": "custom",
        },
        {
            "key": "{#38;5;244}│ {#31}{icon} Distro    {#keys}{#38;5;244}│",
            "type": "os",
        },
        {
            "key": "{#38;5;244}├─────────────┤",
            "type": "custom",
        },            
        {
            "key": "{#38;5;244}│ {#32} Kernel    {#keys}{#38;5;244}│",
            "type": "kernel",
        },
        {
            "key": "{#38;5;244}│ {#32}󰇄 DE        {#keys}{#38;5;244}│",
            "type": "de",
        },
        {
            "key": "{#38;5;244}│ {#32} Terminal  {#keys}{#38;5;244}│",
            "type": "terminal",
        },
        {
            "key": "{#38;5;244}│ {#32}󰍛 CPU       {#keys}{#38;5;244}│",
            "type": "cpu",
            "showPeCoreCount": true,
        },
        {
            "key": "{#38;5;244}│ {#32} Memory    {#keys}{#38;5;244}│",
            "type": "memory",
        },
        {
            "key": "{#38;5;244}├─────────────┤",
            "type": "custom",
        },
        {
            "key": "{#38;5;244}│ {#36} Colours   {#keys}{#38;5;244}│",
            "type": "Colors",
            "symbol": "circle",
        },        
        {
            "key": "{#38;5;244}╰─────────────╯",
            "type": "custom",
        },
    ]
}
